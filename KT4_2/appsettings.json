    "User": "user@yandex.ru",
    "Password": "your-app-password",
    "From": "user@yandex.ru",
    "EnableSsl": true
  },
  "JwtSettings": {
    "Issuer": "https://api.myapp.com",
    "Audience": "https://myapp.com",
    "Secret": "super-secret-key-at-least-32-characters-long!!",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*"
