{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "StorageSettings": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "uploads",
    "UseSsl": false
  },
  "CryptoSettings": {
    "EmailConfirmationCodeLenght": 50,
    "PasswordHashLenght": 256,
    "Pepper": "pepper"
  },
